DISCORD_TOKEN=your_discord_bot_token

# Optional runtime override. Default: node_modules/@deepseek-ai/dsh/lib/bin.js.
# DSH_BIN=/absolute/path/to/dsh/lib/bin.js
DSH_PROFILE=poe
DSH_PROVIDER=google-vertex
# DSH runtime uses Google Vertex and this model ID.
GOOGLE_GEMINI_MODEL=gemini-4-argon
GOOGLE_CLOUD_PROJECT=your_google_cloud_project
GOOGLE_CLOUD_LOCATION=global
DSH_TURN_TIMEOUT_MS=120000
DSH_IDLE_TIMEOUT_MS=300000

# Optional. Leave unset to use the DSH default (~/.dsh).
# DSH_HOME=/path/to/dsh-home
# Vertex AI uses ADC with GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION.

AUTO_REPLY_THRESHOLD=0.90
AUTO_REPLY_TIMEOUT_MS=8000

# Fast IM: independent Vertex API calls, outside the DSH conversation queue.
IM_MODEL=google/gemma-4-26b-a4b-it-maas
IM_FALLBACK_MODEL=gemini-3.1-flash-lite
IM_VERTEX_LOCATION=global
IM_MAX_CONCURRENT=4
IM_TIMEOUT_MS=15000
# Set IM_FALLBACK_MODEL to an empty value to disable fallback.
